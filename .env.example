# Copy this file to backend/.env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civicconnect
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Official accounts (comma-separated emails and a private verification code)
ADMIN_WHITELIST=
ADMIN_SECRET_CODE=

# Demo only. Format: email:synthetic-12-digit-code,email:synthetic-12-digit-code
AADHAAR_WHITELIST=

# Optional image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Gmail notifications
EMAIL_USER=
EMAIL_PASS=
